{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Pin every GitHub Action to a commit SHA, then keep the SHA fresh.
    'helpers:pinGitHubActionDigests',
  ],
  semanticCommits: 'enabled',
  postUpdateOptions: [
    'gomodTidy',
  ],
  labels: [
    'automated',
  ],
  // One PR for every non-breaking update (minor, patch, and action/image digest
  // refreshes) instead of one PR per dependency. Major updates still get their
  // own PR so a breaking change can be reviewed and reverted on its own.
  packageRules: [
    {
      groupName: 'all non-major dependencies',
      groupSlug: 'all-non-major',
      matchPackageNames: [
        '*',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
    },
    // @docusaurus/theme-mermaid declares a peer range of ^0.1.9 on layout-elk,
    // so 0.2.x makes npm refuse to resolve the docs lockfile. Lift this once a
    // theme-mermaid release accepts 0.2.
    {
      matchPackageNames: [
        '@mermaid-js/layout-elk',
      ],
      allowedVersions: '<0.2.0',
    },
  ],
  // The kind_versions.json *array* (the spread of k8s minors the e2e matrix
  // sweeps) is NOT managed here: Renovate would collapse every entry onto the
  // single newest tag. It is refreshed by .github/workflows/k8s-versions-check.yml.
  //
  // This custom manager only handles single-version pins annotated in workflows,
  // e.g. the kind *binary*:
  //   # renovate: datasource=github-releases depName=kubernetes-sigs/kind
  //   KIND_VERSION: v0.32.0
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github\\/workflows\\/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Za-z0-9_]+?_VERSION\\s*:\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
    },
  ],
}
